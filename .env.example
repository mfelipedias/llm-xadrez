# Copie para .env e ajuste se precisar. O .env é gitignored.
PORT=3939
HOST=127.0.0.1
DATA_DIR=./data
LANG=pt-BR
HUMAN_NAME=Você
# debug | info | warn | error | silent. Toda linha passa por redact(): chaves não vão para o log.
LOG_LEVEL=info
# Defina para exigir "Authorization: Bearer <token>" em /mcp (use ao expor por túnel).
# Também vale como token de administração se ADMIN_TOKEN estiver vazio.
MCP_TOKEN=
# Token das rotas que gravam providers.json (tela "Provedores"). O próprio computador
# (localhost) e ADMIN_ALLOW_FROM administram sem token; de outros IPs, a UI pede este token
# e manda "Authorization: Bearer <token>". Vazio = usa o MCP_TOKEN.
ADMIN_TOKEN=
# IPs/CIDRs (separados por vírgula) que administram sem token, além do loopback.
# No Docker o compose já usa 172.16.0.0/12 (a bridge por onde o host chega ao container).
ADMIN_ALLOW_FROM=
# Hosts extras aceitos no header Host, separados por vírgula (ex.: meu-pc.lan,192.168.0.10).
ALLOWED_HOSTS=
# Docker: endereço onde a porta é publicada no host. 127.0.0.1 = só este computador;
# 0.0.0.0 = rede local (defina ADMIN_TOKEN e estreite ADMIN_ALLOW_FROM nesse caso).
BIND_ADDR=127.0.0.1
# URL pela qual os clientes alcançam o servidor (só para exibição: banner, /api/health, UI).
# Útil no Docker com outra porta no host ou atrás de túnel. Vazio = http://localhost:PORT
PUBLIC_URL=

# ---------------------------------------------------------------------------
# Bots do servidor (docs/09). Opcional: sem nada aqui, o projeto segue só com MCP.
# ---------------------------------------------------------------------------
# Chaves de API. NUNCA vão no providers.json — lá fica só o NOME da variável (apiKeyEnv).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
LITELLM_API_KEY=
# Chave de um servidor seu: crie uma variável terminada em _API_KEY, _KEY ou _TOKEN e
# informe o NOME dela no campo apiKeyEnv do provedor. Servidor na rede local (localhost,
# 192.168.x, 10.x, host.docker.internal...) não precisa de chave.
# MEU_SERVIDOR_API_KEY=

# Arquivo de provedores e perfis de bot.
PROVIDERS_FILE=./providers.json
# Recria os bots do current-game.json quando o servidor reinicia.
BOT_AUTORESUME=true
# Perfil de bot sugerido na UI (vazio = `defaults.profileId` do providers.json).
BOT_DEFAULT_PROFILE=
# Injeta o provedor determinístico "fake" (modelo "fake-1") no servidor: usado por
# `npm run smoke:bot`, sem rede e sem custo. Não ligue em produção.
BOT_FAKE_PROVIDER=
